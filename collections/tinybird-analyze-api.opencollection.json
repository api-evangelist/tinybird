{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tinybird Analyze API",
    "version": "v0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Analyze",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Analyze File Schema",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tinybird.co/v0/analyze",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Analyze a given NDJSON, CSV, or Parquet file to generate a Tinybird Data Source schema."
        }
      ]
    }
  ],
  "bundled": true
}